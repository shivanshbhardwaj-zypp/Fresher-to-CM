{
  "name": "bano-zypp-ke-cm-api",
  "version": "1.0.0",
  "description": "Application intake API for the Bano Zypp Ke CM campaign",
  "main": "dist/server.js",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "license": "UNLICENSED",
  "dependencies": {
